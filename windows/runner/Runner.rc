    CONTROL         "接收", IDC_REQUEST_ACCEPT, "Button", BS_OWNERDRAW | WS_TABSTOP, 158, 49, 50, 17
    CONTROL         "关闭提示", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 193, 5, 18, 15
END


